{
  "name": "ai-fitness-coach",
  "version": "1.0.0",
  "description": "AI-powered fitness coaching platform",
  "main": "server/index.js",
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm start",
    "bootstrap": "bash scripts/bootstrap.sh",
    "migrate": "bash scripts/migrate.sh",
    "seed:demo": "bash scripts/seed-demo.sh",
    "test:unit": "node --test server/tests/*.test.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:server": "jest server/__tests__/ --forceExit --detectOpenHandles",
    "test:client": "cd client && npm test -- --watchAll=false"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.1",
    "pg": "^8.11.3",
    "uuid": "^13.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.4"
  }
}
